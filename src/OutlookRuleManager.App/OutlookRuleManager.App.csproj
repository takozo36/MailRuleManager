<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OutlookRuleManager.App</RootNamespace>
    <AssemblyName>MailRuleManager</AssemblyName>
    <Product>Mail Rule Manager for Classic Outlook</Product>
    <FileVersion>0.1.0</FileVersion>
    <!-- Product version (and assembly version) follow FileVersion so that only one place needs to change -->
    <Version>$(FileVersion)</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Settings used by dotnet publish to produce a single exe -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bundle native libraries into the exe as well (extracted to %TEMP%\.net\{app}\ at run time) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <!-- false: use the .NET runtime installed on the PC (small exe).
         Set to true to run on PCs without the runtime (the exe grows by about 100 MB). -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutlookRuleManager.Core\OutlookRuleManager.Core.csproj" />
    <ProjectReference Include="..\OutlookRuleManager.Outlook\OutlookRuleManager.Outlook.csproj" />
  </ItemGroup>
</Project>
