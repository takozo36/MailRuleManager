<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OutlookRuleManager.Outlook</RootNamespace>
  </PropertyGroup>

  <!--
    Outlook is called with late binding (dynamic), so the interop assembly
    (Microsoft.Office.Interop.Outlook) is not referenced. No external package dependencies.
  -->
  <ItemGroup>
    <ProjectReference Include="..\OutlookRuleManager.Core\OutlookRuleManager.Core.csproj" />
  </ItemGroup>
</Project>
